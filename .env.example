# Base URL of the backend API, INCLUDING the /api/v1 path.
# Server-only and read at runtime — every API call happens on the server
# (Server Components, server actions, proxy.ts), never in the browser. Inside
# the production docker-compose this is the internal service address,
# http://api:5050/api/v1, not the public one.
API_BASE_URL=http://localhost:5050/api/v1

# Base URL of this frontend itself, used for sitemap.xml / robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must be the EXACT same value as the backend's ACCESS_TOKEN_SECRET, so
# proxy.ts can verify access tokens the backend issued. A mismatch produces no
# error anywhere — every protected route just bounces to /login.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
